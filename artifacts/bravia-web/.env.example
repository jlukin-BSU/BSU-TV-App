# Port the Node service listens on. nginx proxies to this.
PORT=8080

# Bind address. Keep on loopback so only nginx can reach the service.
HOST=127.0.0.1

# Path to the device config. Defaults to ./devices.json relative to the working directory.
DEVICES_CONFIG=/etc/bravia-web/devices.json

# Set to force every display into dry-run regardless of devices.json.
# Useful for a quick smoke test with no hardware attached.
# BRAVIA_DRY_RUN=1

# How long to wait for a display to answer, in milliseconds (default 5000).
# BRAVIA_TIMEOUT_MS=5000

# pino log level: trace|debug|info|warn|error
LOG_LEVEL=info

NODE_ENV=production

# Admin panel: set a shared password to enable the on-screen gear + admin API.
# Leave unset to disable admin entirely (no gear shown).
ADMIN_PASSWORD=change-me-strong

# Where the app stores per-display admin settings (tile visibility/order).
# No secrets go in this file. Defaults to overrides.json beside devices.json.
ADMIN_OVERRIDES=/etc/bravia-web/overrides.json
