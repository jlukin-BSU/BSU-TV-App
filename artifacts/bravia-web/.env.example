# Port the service listens on. Bound directly (no nginx); 80 for plain HTTP so
# displays load http://its-avctrl-bsu-av/ with no port in the URL.
PORT=80

# Bind address. 0.0.0.0 so displays on the AV VLAN can reach it.
HOST=0.0.0.0

# Path to the device config (per-display IP + PSK). Holds secrets -- keep tight.
DEVICES_CONFIG=/etc/bravia-web/devices.json

# Where per-display admin settings (tile visibility/order) are stored. No
# secrets in this file. Defaults to overrides.json beside devices.json.
ADMIN_OVERRIDES=/etc/bravia-web/overrides.json

# Per-app launch-target overrides (edited from the management page). No secrets.
APP_OVERRIDES=/etc/bravia-web/app-overrides.json

# Set to force every display into dry-run regardless of devices.json.
# BRAVIA_DRY_RUN=1

# How long to wait for a display to answer, in milliseconds (default 5000).
# BRAVIA_TIMEOUT_MS=5000

# Only set if a reverse proxy is ever placed in front (e.g. "loopback"). Left
# unset the service trusts only the raw socket IP -- correct for direct binding.
# TRUST_PROXY=

# pino log level: trace|debug|info|warn|error
LOG_LEVEL=info

# Device-registration management page (separate port, phone-friendly). Set a PIN to enable it; unset means the management server does not start
# and the device registry cannot be edited over the network.
MGMT_PIN=0000
MGMT_PORT=8081

NODE_ENV=production
