<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <size android:width="108dp" android:height="108dp" />
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.0"
                android:gradientRadius="88dp"
                android:startColor="#303030"
                android:endColor="#222222" />
        </shape>
    </item>

    <item
        android:width="84dp"
        android:height="31dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/bsu_logo"
            android:gravity="fill"
            android:tint="#FFFFFF" />
    </item>
</layer-list>
