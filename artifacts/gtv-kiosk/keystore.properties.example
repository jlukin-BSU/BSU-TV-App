# Copy to keystore.properties and fill in. That file is gitignored -- never commit it.
#
# The keystore itself lives OUTSIDE this repo. Losing it, or its password, means
# no display with this app installed can ever be updated again; the only way back
# is uninstalling and reinstalling on every unit. Back it up somewhere
# institutional, and keep the password in a password manager.
#
# Generate one with:
#   keytool -genkeypair -v -keystore ~/bsu-tv-release.jks -storetype PKCS12 \
#     -alias bsu-tv -keyalg RSA -keysize 4096 -validity 10950

storeFile=C:/Users/jlukin/bsu-tv-release.jks
storePassword=
keyAlias=bsu-tv
keyPassword=
